# Copia este archivo como .env y cambia los valores. Nunca subas .env al repositorio.
POSTGRES_PASSWORD=cambia-esta-contrasena
JWT_SECRETO=cambia-este-secreto-largo-y-aleatorio
# Dirección pública de la app (se usa en los enlaces de restablecimiento de contraseña)
URL_APP=http://localhost
# true cuando la app se sirve por HTTPS
COOKIE_SEGURA=false
